/**
 * @file Features.hpp
 * @brief Build-time feature selection for Tyrant Game Engine public headers.
 *
 * This file is generated by CMake. Applications must consume the copy that was
 * produced for the TGE runtime they link against.
 */

#pragma once

#define TGE_CXX_STANDARD 26

#define TGE_REFLECTION_DI_CONFIGURED @TGE_HAS_REFLECTION_DI_VALUE@
#if TGE_REFLECTION_DI_CONFIGURED && \
    defined(__cpp_impl_reflection) && __cpp_impl_reflection >= 202603L
    #define TGE_HAS_REFLECTION_DI 1
#else
    #define TGE_HAS_REFLECTION_DI 0
#endif

#define TGE_CXX26_OPTIONS_REFLECTION_CONFIGURED \
    @TGE_HAS_CXX26_OPTIONS_REFLECTION_VALUE@
#if defined(GLZ_REFLECTION26)
    #if TGE_CXX26_OPTIONS_REFLECTION_CONFIGURED && GLZ_REFLECTION26
        #define TGE_HAS_CXX26_OPTIONS_REFLECTION 1
    #else
        #define TGE_HAS_CXX26_OPTIONS_REFLECTION 0
    #endif
#elif TGE_CXX26_OPTIONS_REFLECTION_CONFIGURED && \
      defined(__cpp_impl_reflection) && __cpp_impl_reflection >= 202603L
    #define TGE_HAS_CXX26_OPTIONS_REFLECTION 1
#else
    #define TGE_HAS_CXX26_OPTIONS_REFLECTION 0
#endif

#define TGE_HAS_NATIVE_STD_EXECUTION @TGE_HAS_NATIVE_STD_EXECUTION_VALUE@
#define TGE_HAS_STD_EXECUTION_TASK @TGE_HAS_NATIVE_STD_EXECUTION_VALUE@
#define TGE_USES_STDEXEC @TGE_USES_STDEXEC_VALUE@
